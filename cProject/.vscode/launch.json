    "version": "0.2.0",
    "configurations": [
    {
      "name": "C++ 调试 (Conda GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Fastest",  // 改成你的目标文件名
      "args": ["-d", "parler"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "LD_LIBRARY_PATH",
          "value": "/home/wangshuo/software/anaconda3/lib:${LD_LIBRARY_PATH}"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/home/wangshuo/software/anaconda3/bin/gdb",
      "setupCommands": [
        {
          "description": "启用 gdb 美化输出",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}